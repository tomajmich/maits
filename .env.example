# --- cTrader Open API application (https://openapi.ctrader.com -> Applications) ---
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the application. It never has to
# be reachable: after login you just copy the URL from the browser's address bar.
CTRADER_REDIRECT_URI=http://localhost:8080/callback

# demo or live. Selects the server AND is checked against the account you use,
# so a demo setting can never trade a live account.
CTRADER_ENV=demo
# ctidTraderAccountId (run `maits accounts`). Optional if the token has exactly
# one account of the chosen environment.
CTRADER_ACCOUNT_ID=

# --- Safety limits (enforced for both the console and the HTTP API) ---
MAITS_MAX_LOTS=0.10
# Comma separated allow-list, empty = any symbol
MAITS_ALLOWED_SYMBOLS=

# --- HTTP API (`maits serve`) ---
# Required to start the server. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
MAITS_API_KEY=
# TradingView can't send headers, so its alerts carry this secret in the JSON body. Empty = webhook disabled.
MAITS_WEBHOOK_SECRET=
MAITS_API_HOST=127.0.0.1
MAITS_API_PORT=8000

# Where OAuth tokens are stored (chmod 600)
MAITS_TOKEN_FILE=tokens.json
